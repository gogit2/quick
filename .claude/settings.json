{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(.specify/scripts/bash/*)",
      "Bash(scripts/*)",
      "Bash(./scripts/*)",
      "Bash(python3 scripts/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(sudo:*)"
    ]
  }
}