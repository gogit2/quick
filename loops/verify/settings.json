{
  "$comment": "Headless permissions for the verify loop (used via --settings with --permission-mode acceptEdits and --permission-prompts none: anything not allowed is denied).",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "TodoWrite",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(jq:*)",
      "Bash(date:*)",
      "Bash(sleep:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(test:*)",
      "Bash(true:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(xargs:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(tee:*)",
      "Bash(rm:*)",
      "Bash(python3 -I:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(./scripts/backend.sh:*)",
      "Bash(scripts/backend.sh:*)",
      "Bash(./scripts/frontend.sh:*)",
      "Bash(scripts/frontend.sh:*)",
      "Bash(./scripts/mock.sh:*)",
      "Bash(scripts/mock.sh:*)",
      "Bash(./scripts/export-swagger.sh:*)",
      "Bash(scripts/export-swagger.sh:*)",
      "Bash(./scripts/curl-regression.sh:*)",
      "Bash(scripts/curl-regression.sh:*)",
      "Bash(./mvnw:*)",
      "Bash(mvn:*)",
      "Bash(java:*)",
      "Bash(curl:*)",
      "Bash(bash loops/backend-dev/outputs/curl/*)",
      "Bash(loops/backend-dev/outputs/curl/*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(curl:*)",
      "Bash(bash loops/*)",
      "Bash(loops/*)",
      "mcp__playwright",
      "Bash(scripts/testid-check.sh:*)",
      "Bash(./scripts/testid-check.sh:*)",
      "Bash(scripts/colour-check.sh:*)",
      "Bash(./scripts/colour-check.sh:*)",
      "Bash(scripts/bundle-size.sh:*)",
      "Bash(./scripts/bundle-size.sh:*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git tag:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git restore:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ..*)",
      "Edit(specs/**/contracts/**)",
      "Write(specs/**/contracts/**)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.specify/**)",
      "Write(.specify/**)",
      "Edit(requirements/**)",
      "Write(requirements/**)",
      "Edit(loops/_shared/milestones.json)",
      "Write(loops/_shared/milestones.json)",
      "Edit(tools/**)",
      "Write(tools/**)",
      "Edit(.mcp.json)",
      "Write(.mcp.json)",
      "Edit(run-artifacts/**)",
      "Write(run-artifacts/**)",
      "WebFetch",
      "WebSearch",
      "Edit(loops/backend-dev/**)",
      "Write(loops/backend-dev/**)",
      "Edit(loops/frontend-dev/**)",
      "Write(loops/frontend-dev/**)",
      "Edit(loops/verify/state/state.json)",
      "Write(loops/verify/state/state.json)"
    ],
    "defaultMode": "acceptEdits"
  },
  "env": {
    "PLAYWRIGHT_BROWSERS_PATH": "tools/.browsers"
  }
}