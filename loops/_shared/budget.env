# Per-milestone cost ceilings in USD (sum of BE + FE + verify sessions).
# A running session cannot be stopped mid-way; each session also gets --max-budget-usd = remaining.
BUDGET_DEFAULT_USD=15
# Milestones listed here use BUDGET_LARGE_USD (the final hardening/E2E milestone).
BUDGET_LARGE_MILESTONES="M07 M11"
BUDGET_LARGE_USD=25
# Fresh budget for the single Sonnet upgrade retry.
BUDGET_UPGRADE_USD=15

# Models
MODEL_DEV=claude-haiku-5-5
MODEL_VERIFY=claude-opus-5-5
MODEL_UPGRADE=claude-sonnet-5-5
MODEL_PLAN=claude-sonnet-5-5

# Limits
MAX_TRIALS=3
TASKS_PER_ITERATION=5
ITERATION_SLACK=3          # iteration cap = ceil(tasks / TASKS_PER_ITERATION) + ITERATION_SLACK
SESSION_TIMEOUT=45m
